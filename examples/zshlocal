# ==============================================================================
# LOCAL ZSH CUSTOMIZATION — MASTER CONTROL PANEL
# Machine-local overrides, sourced LAST by .zshrc. Gitignored, never
# overwritten by updates. Every framework tunable appears below with its
# default — uncomment and change what you need.
# ==============================================================================

# ----------------------------------------------------------
# * LOGGING (lib/core/logging.zsh)
# ----------------------------------------------------------
# export Z_LOG_LEVEL=WARN                # DEBUG | INFO | WARN | ERROR | NONE
# export Z_LOG_COLOR=true                # Colored log output
# export Z_LOG_TIMESTAMP_ENABLE=false    # Prefix log lines with a timestamp
# export Z_LOG_TIMESTAMP_FORMAT="%H:%M:%S"
# export Z_LOG_SHOW_CALLER=false         # Show calling function in logs
# export Z_LOG_SHOW_PID=false            # Show shell PID in logs
# export Z_LOG_SHOW_SHELL=false          # Show shell name in logs

# ----------------------------------------------------------
# * PATH (modules/01_path.zsh)
# ----------------------------------------------------------
# export Z_PATH_ENABLED=true             # Master switch for PATH management
# export Z_PATH_HOMEBREW=true            # Add Homebrew paths
# export Z_PATH_CLEAN=true               # Remove dead PATH entries after startup
# export Z_PATH_SSH_MINIMAL=true         # Minimal PATH in SSH sessions
# export Z_PATH_FORCE_MINIMAL=false      # Force minimal PATH everywhere
# export Z_PATH_PROJECT_BIN=false        # Add ./bin, ./node_modules/.bin, ...
#                                        # WARNING: only in trusted repositories

# ----------------------------------------------------------
# * ENVIRONMENT (modules/02_environment.zsh)
# ----------------------------------------------------------
# export Z_ENVIRONMENT_ENABLED=true      # Master switch for env management
# export Z_ENVIRONMENT_XDG_STRICT=true   # Enforce XDG paths for tools
# export Z_ENVIRONMENT_SSH_MINIMAL=true  # Slimmer environment over SSH
# export Z_ENVIRONMENT_SSH_AGENT=true    # Auto-detect SSH agent socket
#                                        # (1Password > GPG > GNOME > existing)
# export Z_LOCALE_OVERRIDE=""            # e.g. "en_US.UTF-8"; empty = system
# export Z_GUI_EDITORS_ORDER="surf cursor code"
# export Z_TERMINAL_EDITORS_ORDER="nvim vim vi"

# Force a specific SSH agent socket (overrides auto-detection; interactive
# shells only — .zshlocal loads after detection ran in .zshenv)
# export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"

# ----------------------------------------------------------
# * LAZY LOADING (modules/03_lazy.zsh)
# ----------------------------------------------------------
# export Z_LAZY_ENABLED=true             # Master switch for lazy loading
# export Z_LAZY_ZOXIDE=true              # Defer zoxide init to first z/zi
# export Z_LAZY_NVM=true                 # Defer nvm (wraps node/npm/npx/...)
# export Z_LAZY_PYENV=true               # Defer pyenv (wraps python/pip)
# export Z_LAZY_RBENV=true               # Defer rbenv (wraps ruby/gem)

# ----------------------------------------------------------
# * COMPLETION (modules/04_completion.zsh)
# ----------------------------------------------------------
# export Z_COMPLETION_ENABLED=true       # Master switch for completions
# export Z_COMPLETION_MENU_SELECT=true   # Arrow-key completion menu
# export Z_COMPLETION_TTL=86400          # Seconds before compdump refresh
# export Z_COMPLETION_AUDIT_TTL=604800   # Seconds between compaudit runs

# ----------------------------------------------------------
# * PLUGINS (lib/plugins/index.zsh)
# ----------------------------------------------------------
# export Z_PLUGINS_DIR="$XDG_DATA_HOME/zsh/plugins"  # Plugin clone location

# ----------------------------------------------------------
# * HISTORY (modules/05_history.zsh)
# ----------------------------------------------------------
# export Z_HISTORY_ENABLED=true          # Master switch for history config
# export Z_HISTORY_SIZE=100000           # In-memory history size
# export Z_HISTORY_SAVE_SIZE=100000      # Persisted history size
# export Z_HISTORY_SECURITY_FILTER=true  # Keep secrets out of HISTFILE
# export Z_HISTORY_LARGE_FILE_THRESHOLD=500000  # Warn when HISTFILE exceeds

# ----------------------------------------------------------
# * ALIASES & REPLACEMENTS (modules/06_aliases.zsh)
# The installer's replacement step manages a Z_REPLACE_* block at the
# bottom of your .zshlocal; you can also set them here by hand. The
# original command is always reachable via `command <name>` or \<name>.
# ----------------------------------------------------------
# export Z_ALIASES_ENABLED=true          # Master switch for aliases
# export Z_ALIASES_MODERN_TOOLS=true     # Extra aliases for modern tools
# export Z_ALIASES_SAFETY_PROMPTS=true   # cp/mv/rm interactive prompts
# export Z_REPLACE_EZA=true              # ls  -> eza   (default on)
# export Z_REPLACE_BAT=false             # cat -> bat --paging=never
# export Z_REPLACE_DUST=false            # du  -> dust
# export Z_REPLACE_DUF=false             # df  -> duf
# export Z_REPLACE_BTM=false             # top -> btm
# export Z_REPLACE_GPING=false           # ping -> gping
# export Z_REPLACE_TRIPPY=false          # traceroute -> trip

# ----------------------------------------------------------
# * KEYBINDINGS (modules/07_keybindings.zsh)
# ----------------------------------------------------------
# export Z_KEYBINDINGS_ENABLED=true      # Master switch for keybindings

# ----------------------------------------------------------
# * XDG GUARDIAN (lib/functions/xdg.zsh)
# ----------------------------------------------------------
# export Z_XDG_GUARDIAN_ENABLED=true     # Daily $HOME hygiene scan
# export Z_XDG_GUARDIAN_MODE=notify      # notify | interactive | off
# export Z_XDG_GUARDIAN_INTERVAL=86400   # Seconds between scans
# export Z_XDG_GUARDIAN_QUIET=false      # Suppress the summary line
# export Z_XDG_GUARDIAN_AUTO_FIX=false   # Auto-migrate ready items (careful)
# export Z_XDG_GUARDIAN_SKIP=""          # Space-separated paths to ignore

# ----------------------------------------------------------
# * UPDATES (lib/functions/framework.zsh)
# ----------------------------------------------------------
# export Z_UPDATE_CHECK_ENABLED=true     # Check for framework updates
# export Z_UPDATE_CHECK_INTERVAL=86400   # Seconds between checks
# export Z_UPDATE_AUTO_FETCH=true        # Background git fetch
# export Z_UPDATE_PROMPT=true            # Ask before applying updates
# export Z_UPDATE_AUTO_APPLY=false       # Apply updates without asking

# ----------------------------------------------------------
# * STARTUP PROFILING (lib/core/profile.zsh)
# ----------------------------------------------------------
# export Z_PROFILE_STARTUP=true          # Per-stage timings (view: profile)
# export Z_PROFILE_STARTUP=zprof         # Function-level zprof report

# ----------------------------------------------------------
# * SECURITY
# ----------------------------------------------------------
# export Z_VERIFY_FILE_OWNERSHIP=true    # Verify sourced-file ownership
#                                        # (shared/multi-user systems)

# ----------------------------------------------------------
# * PERSONAL ALIASES & FUNCTIONS
# ----------------------------------------------------------
# alias dev='cd ~/Development'
# my_function() {
#     echo "Hello from my custom function"
# }

# ----------------------------------------------------------
# * MACHINE-SPECIFIC SETTINGS
# ----------------------------------------------------------
# if [[ "$(hostname)" == "work-laptop" ]]; then
#     export HTTP_PROXY="http://proxy.company.com:8080"
# fi

