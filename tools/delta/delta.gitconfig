# ==============================================================================
# DELTA GIT INTEGRATION
# Included from git's global config via include.path (installer-managed).
# ==============================================================================

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default
