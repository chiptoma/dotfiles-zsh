# ==============================================================================
# TOOL CONFIG MANIFEST
# Maps shipped tool configs to their install destinations.
# ==============================================================================
#
# Format: tool:source:dest:mode
#
# Fields:
#   tool   - Catalog name from lib/registry/tools.dat (config installs only
#            when the tool's binary is present)
#   source - Path relative to tools/
#   dest   - Destination; $XDG_CONFIG_HOME and ~ tokens are expanded
#   mode   - copy       = back up any existing file, then copy into place
#            gitinclude = copy, then idempotently add to git's global
#                         include.path
#
# Lines starting with # are comments. Empty lines are ignored.
# ==============================================================================

starship:starship/starship.toml:$XDG_CONFIG_HOME/starship.toml:copy
atuin:atuin/config.toml:$XDG_CONFIG_HOME/atuin/config.toml:copy
bat:bat/config:$XDG_CONFIG_HOME/bat/config:copy
ripgrep:ripgrep/ripgreprc:$XDG_CONFIG_HOME/ripgrep/config:copy
delta:delta/delta.gitconfig:$XDG_CONFIG_HOME/git/delta.gitconfig:gitinclude
lazygit:lazygit/config.yml:$XDG_CONFIG_HOME/lazygit/config.yml:copy
btm:btm/bottom.toml:$XDG_CONFIG_HOME/bottom/bottom.toml:copy
fastfetch:fastfetch/config.jsonc:$XDG_CONFIG_HOME/fastfetch/config.jsonc:copy
tldr:tldr/config.toml:$XDG_CONFIG_HOME/tealdeer/config.toml:copy
